# Backend configuration (example)
# NOTE: Do not commit real secrets. Provide values via the container's .env.

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# JWT
# Used to sign access tokens. MUST be set in production.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database connection
# IMPORTANT: This project uses portfolio_database/db_connection.txt as the source-of-truth.
# The backend reads that file at runtime and extracts the postgresql://... URL.
# If you want to override, provide DATABASE_URL explicitly.
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
