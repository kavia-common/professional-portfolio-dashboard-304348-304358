# Backend configuration example (copy to .env and fill values)

# REQUIRED in production:
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated or JSON-like list supported by pydantic; simplest: allow all)
ALLOWED_ORIGINS=["*"]

# Database
# If not set, backend attempts to read portfolio_database/db_connection.txt from workspace.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Server
HOST=0.0.0.0
